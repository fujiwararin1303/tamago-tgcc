namespace main {

    fn main() -> int32 {
        // -------------------------------------------------------
        // This is the most "computationally interesting" program
        // possible with only straight-line arithmetic right now.
        // -------------------------------------------------------

        var zero: int32 = 0;
        var one: int32 = 1;
        var two: int32 = 2;
        var three: int32 = 3;
        var four: int32 = 4;
        var five: int32 = 5;
        var six: int32 = 6;
        var seven: int32 = 7;
        var eight: int32 = 8;
        var nine: int32 = 9;
        var ten: int32 = 10;

        // Some arbitrary but non-trivial arithmetic cascade
        var a: int32 = seven * three - four;                    // 21 - 4 = 17
        var b: int32 = a * two + five;                          // 34 + 5 = 39
        var c: int32 = b - ten * three;                         // 39 - 30 = 9
        var d: int32 = c * c;                                   // 81
        var e: int32 = d / three + one;                         // 27 + 1 = 28
        var f: int32 = (e + nine) * two - six;                  // 37 * 2 - 6 = 68
        var g: int32 = f - (ten * seven - three * four);       // 68 - (70 - 12) = 10
        var h: int32 = g * g * g / eight;                       // 1000 / 8 = 125
        var i: int32 = h - (five * five * five);                // 125 - 125 = 0
        var j: int32 = i + (ten * ten - three * three * three); // 0 + (100 - 27) = 73

        // Final result — a fixed but somewhat complex expression
        return j;
    }

}